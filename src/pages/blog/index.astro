---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Lakukan pengambilan data artikel secara langsung menggunakan fetch API
const res = await fetch("https://cms.ngreksodigital.com/ahmadfaqihdev/wp-json/wp/v2/posts?_embed");
const wpPosts = await res.json();

// Helper: remove HTML tags for word count
const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, '');
---

<BaseLayout
  title="Blogs | Ahmad Faqih"
  description="Kumpulan artikel, case study, dan hasil riset seputar Web Development dan Technical SEO dari Ahmad Faqih."
>

  <!-- ── Banner Header ── -->
  <section class="border-b border-zinc-900 bg-zinc-950/60 py-20 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <div class="mb-4 flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-[#bfff00]/50"></span>
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-[#bfff00]">Content Hub</span>
        <span class="h-px w-8 bg-[#bfff00]/50"></span>
      </div>
      <h1
        class="mb-4 text-5xl font-black tracking-tight text-white"
        style="font-family:'Space Grotesk',sans-serif;"
      >
        Blogs
      </h1>
      <nav aria-label="Breadcrumb" class="flex items-center justify-center gap-2 text-sm text-zinc-400">
        <a href="/" class="transition-colors duration-200 hover:text-white">Home</a>
        <span class="font-bold text-[#bfff00]">»</span>
        <span class="text-white">Blogs</span>
      </nav>
    </div>
  </section>

  <!-- ── Article Grid ── -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {wpPosts.map((post: any) => {
          // Extract data from WP REST API response
          const title = post.title.rendered;
          const excerpt = post.excerpt.rendered;
          const image = post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '/images/default-blog.jpg';
          const category = post._embedded?.['wp:term']?.[0]?.[0]?.name || 'Uncategorized';
          const tags = post._embedded?.['wp:term']?.[1] || [];
          const author = post._embedded?.author?.[0]?.name || 'Ahmad Faqih';
          
          const wordCount = stripHtml(post.content.rendered || '').split(/\s+/).length;
          const readingTime = Math.ceil(wordCount / 200) || 1;

          return (
          <article
            class="group flex flex-col justify-between rounded-3xl border border-zinc-800 bg-[#111] p-6 transition-all duration-300 hover:border-[#bfff00]/20 hover:shadow-[0_0_32px_rgba(191,255,0,0.05)]"
            id={`blog-${post.id}`}
          >
            <div>
              <!-- Thumbnail -->
              <div class="relative mb-5 overflow-hidden rounded-2xl bg-zinc-800" style="aspect-ratio:16/9;">
                <img
                  src={image}
                  alt={title}
                  class="h-full w-full object-cover opacity-90 transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span
                  class="absolute left-3 top-3 rounded-full border border-[#bfff00]/30 bg-black/60 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-[#bfff00] backdrop-blur-sm"
                  set:html={category}
                />
              </div>

              <!-- Meta row -->
              <div>
                <div>
                  {tags.map((tag: any) => (
                    <span class="bg-zinc-900 text-zinc-400 border border-zinc-800/60 rounded-full px-2.5 py-1 text-xs font-medium mr-1.5 inline-block mb-3" set:html={`#${tag.name}`} />
                  ))}
                </div>
                <div class="flex items-center gap-2 text-xs text-zinc-500 mb-4">
                  <span class="text-white font-thin">{author}</span> &bull; {readingTime} min read
                </div>
              </div>

              <!-- Title -->
              <h2
                class="mb-2 text-xl font-bold leading-snug text-white transition-colors duration-300 group-hover:text-[#bfff00]"
                style="font-family:'Space Grotesk',sans-serif;"
                set:html={title}
              />

              <!-- Excerpt -->
              <div class="mb-6 text-sm leading-relaxed text-zinc-400" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;" set:html={excerpt} />
            </div>

            <!-- CTA Button -->
            <a
              href={`/blog/${post.slug}`}
              class="inline-block self-start rounded-full bg-[#bfff00] px-5 py-2.5 text-sm font-semibold text-black transition-all duration-300 hover:bg-[#d4ff33] hover:shadow-[0_0_16px_rgba(191,255,0,0.4)] active:scale-95"
            >
              Learn more
            </a>
          </article>
          );
        })}
      </div>
    </div>
  </section>

</BaseLayout>
