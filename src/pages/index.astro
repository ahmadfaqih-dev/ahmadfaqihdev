---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Latest 5 projects for homepage
const latestProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

// Latest 3 posts for homepage Blog Section
let latestPosts: any[] = [];
try {
  const blogRes = await fetch("https://cms.ngreksodigital.com/ahmadfaqihdev/wp-json/wp/v2/posts?_embed", {
    headers: {
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
      'Accept': 'application/json',
    }
  });
  if (blogRes.ok) {
    const wpPosts = await blogRes.json();
    if (Array.isArray(wpPosts)) {
      latestPosts = wpPosts.slice(0, 3);
    }
  } else {
    console.error(`Failed to fetch homepage blog posts. Status: ${blogRes.status}`);
  }
} catch (error) {
  console.error("Error fetching homepage blog posts:", error);
}

// Helper: remove HTML tags for word count
const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, '');

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
