---
import BaseLayout from '../../layouts/BaseLayout.astro';

const WP_HEADERS = {
  'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
  'Accept': 'application/json',
};

let allProducts: any[] = [];
try {
  const res = await fetch("https://cms.ngreksodigital.com/ahmadfaqihdev/wp-json/wp/v2/product?_embed&per_page=100", {
    headers: WP_HEADERS,
  });
  if (!res.ok) {
    console.error(`Failed to fetch product. Status: ${res.status}`);
  } else {
    const data = await res.json();
    if (Array.isArray(data)) {
      allProducts = data;
    }
  }
} catch (error) {
  console.error("Error fetching product:", error);
}
---

<BaseLayout
  title="Produk Digital | Ahmad Faqih"
  description="Koleksi template, eBook, theme, dan tools digital premium — siap pakai untuk mempercepat workflow dan meningkatkan konversi bisnis Anda."
>

  <!-- ── Banner Header ── -->
  <section class="relative border-b border-zinc-900 bg-zinc-950/60 py-20 text-center overflow-hidden">
    <!-- BG Glow decorations -->
    <div class="pointer-events-none absolute -left-40 -top-40 h-96 w-96 rounded-full bg-lime-400/5 blur-[120px]"></div>
    <div class="pointer-events-none absolute -right-40 top-10 h-80 w-80 rounded-full bg-blue-500/5 blur-[100px]"></div>

    <div class="relative mx-auto max-w-3xl px-6">
      <div class="mb-4 flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-[#00aee0]"></span>
        <span class="text-sm font-semibold uppercase tracking-[0.2em] bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">Digital Store</span>
        <span class="h-px w-8 bg-[#00aee0]"></span>
      </div>
      <h1
        class="mb-4 text-5xl font-black tracking-tight text-white xl:text-6xl"
        style="font-family:'Space Grotesk',sans-serif;"
      >
        Produk <span class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">Digital</span>
      </h1>
      <p class="mx-auto mb-6 max-w-lg text-base leading-relaxed text-white/50">
        Template, eBook, dan tools digital premium yang dirancang untuk <span class="font-semibold text-white/80">mempercepat workflow</span> dan <span class="font-semibold text-white/80">scale bisnis Anda</span>.
      </p>
      <nav aria-label="Breadcrumb" class="flex items-center justify-center gap-2 text-sm text-zinc-400">
        <a href="/" class="transition-colors duration-200 hover:text-white">Home</a>
        <span class="font-bold bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">»</span>
        <span class="text-white">Produk Digital</span>
      </nav>
    </div>
  </section>

  <!-- ── Product Grid ── -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">

      <!-- Products count -->
      {allProducts.length > 0 && (
        <p class="mb-8 text-sm text-zinc-500">
          Menampilkan <span class="font-semibold text-white">{allProducts.length}</span> produk digital
        </p>
      )}

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" id="products-grid">
        {allProducts.map((product: any, index: number) => {
          if (!product?.title?.rendered) return null;
          const image = product._embedded?.['wp:featuredmedia']?.[0]?.source_url || '/images/default-product.jpg';
          const productTerms = product._embedded?.['wp:term']?.flat?.() || [];
          const typeLabel = productTerms.find((t: any) => t.taxonomy === 'type-product')?.name || '';
          const previewUrl = product.acf?.preview || '';
          const buyNowUrl = product.acf?.buy_now || '';

          return (
            <article
              class={`group flex flex-col rounded-3xl border border-zinc-800 bg-[#111] transition-all duration-500 hover:border-blue-500/30 hover:shadow-[0_0_40px_rgba(59,130,246,0.08)] overflow-hidden`}
              id={`product-${product.id}`}
            >
              {/* Thumbnail with overlay */}
              <div class="relative overflow-hidden bg-zinc-800" style="aspect-ratio:16/9;">
                <img
                  src={image}
                  alt={product.title.rendered}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                />
                {/* Gradient overlay */}
                <div class="absolute inset-0 bg-gradient-to-t from-[#111]/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                {/* Type badge */}
                {typeLabel && (
                  <span class="absolute left-4 top-4 rounded-full border border-[#bfff00]/30 bg-black/60 px-3 py-1 text-[10px] font-bold uppercase tracking-widest bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent backdrop-blur-sm">
                    {typeLabel}
                  </span>
                )}

                {/* Quick-view arrow */}
                <a
                  href={`/product/${product.slug}`}
                  class="absolute bottom-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 hover:bg-white/20"
                  aria-label={`Lihat detail ${product.title.rendered}`}
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/>
                  </svg>
                </a>
              </div>

              {/* Content */}
              <div class="flex flex-1 flex-col p-6">
                {/* Title */}
                <a href={`/product/${product.slug}`} class="block">
                  <h2
                    class="mb-2 text-xl font-bold leading-snug text-white transition-colors duration-300 group-hover:text-cyan-400"
                    style="font-family:'Space Grotesk',sans-serif;"
                    set:html={product.title.rendered}
                  />
                </a>

                {/* Excerpt */}
                <div
                  class="mb-6 flex-1 text-sm leading-relaxed text-zinc-400"
                  style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;"
                  set:html={product.excerpt?.rendered || ''}
                />

                {/* Divider */}
                <div class="mb-5 h-px w-full bg-zinc-800/80"></div>

                {/* Action Buttons */}
                <div class="flex flex-wrap items-center gap-3">
                  {previewUrl && (
                    <a
                      href={previewUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/btn inline-flex items-center gap-2 rounded-full border border-zinc-600 px-5 py-2.5 text-sm font-semibold text-white/70 transition-all duration-300 hover:border-cyan-400/50 hover:text-cyan-400 hover:shadow-[0_0_12px_rgba(59,130,246,0.15)]"
                    >
                      <svg class="h-4 w-4 transition-transform duration-300 group-hover/btn:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                      </svg>
                      Preview
                    </a>
                  )}
                  {buyNowUrl && (
                    <a
                      href={buyNowUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-full bg-lime-400 px-5 py-2.5 text-sm font-bold text-black transition-all duration-300 hover:bg-lime-300 hover:shadow-[0_0_20px_rgba(163,230,53,0.4)] active:scale-95"
                    >
                      Beli Sekarang
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/>
                      </svg>
                    </a>
                  )}
                  {!previewUrl && !buyNowUrl && (
                    <a
                      href={`/product/${product.slug}`}
                      class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 px-5 py-2.5 text-sm font-bold text-white transition-all duration-300 hover:from-blue-500 hover:to-cyan-400 hover:shadow-[0_0_25px_rgba(59,130,246,0.6)] active:scale-95"
                    >
                      Lihat Detail
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      {/* Empty state */}
      {allProducts.length === 0 && (
        <div class="flex flex-col items-center justify-center py-20 text-center">
          <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full border border-zinc-800 bg-zinc-900">
            <svg class="h-8 w-8 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
            </svg>
          </div>
          <p class="text-lg font-bold text-white" style="font-family:'Space Grotesk',sans-serif;">Belum ada produk</p>
          <p class="mt-2 text-sm text-zinc-500">Produk digital akan segera tersedia. Stay tuned!</p>
        </div>
      )}
    </div>
  </section>

</BaseLayout>
