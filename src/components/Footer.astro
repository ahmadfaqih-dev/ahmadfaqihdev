---
// Footer.astro — Global footer component
---

<footer
  class="border-t border-zinc-900 bg-black pb-8 pt-20 text-white"
  id="contact"
>
  <div class="mx-auto max-w-7xl px-6">
    <!-- ── 4-Column Grid ── -->
    <div class="mb-16 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- ─── Col 1: Brand & Socials ─── -->
      <div class="flex flex-col gap-6" id="footer-brand">
        <a href="#home" class="inline-block">
          <span
            class="text-2xl font-black tracking-[0.15em] text-white transition-colors duration-300 hover:text-[#bfff00]"
            style="font-family:'Space Grotesk',sans-serif;">AHMAD FAQIH</span
          >
        </a>
        <p class="text-sm leading-relaxed text-zinc-400">
          Digital business providing premium website development, search engine
          optimization, and advanced online advertising services to accelerate
          your growth.
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-3">
          <!-- Facebook -->
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#bfff00] text-black
                   transition-all duration-300 hover:bg-[#d4ff33] hover:shadow-[0_0_14px_rgba(191,255,0,0.5)] active:scale-95"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a
            href="https://x.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#bfff00] text-black
                   transition-all duration-300 hover:bg-[#d4ff33] hover:shadow-[0_0_14px_rgba(191,255,0,0.5)] active:scale-95"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#bfff00] text-black
                   transition-all duration-300 hover:bg-[#d4ff33] hover:shadow-[0_0_14px_rgba(191,255,0,0.5)] active:scale-95"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#bfff00] text-black
                   transition-all duration-300 hover:bg-[#d4ff33] hover:shadow-[0_0_14px_rgba(191,255,0,0.5)] active:scale-95"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- ─── Col 2: Quick Links ─── -->
      <div id="footer-links">
        <h3
          class="relative mb-6 pb-3 text-xl font-bold tracking-wide text-white
                 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-12 after:bg-[#bfff00] after:content-['']"
          style="font-family:'Space Grotesk',sans-serif;"
        >
          Quick Links
        </h3>
        <ul class="space-y-3">
          {
            [
              { label: "Home", href: "#home" },
              { label: "About Me", href: "#about" },
              { label: "Services", href: "#services" },
              { label: "Projects", href: "#projects" },
              { label: "Blog", href: "#blog" },
              { label: "Contact", href: "#contact" },
            ].map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="group flex items-center gap-2 text-sm text-zinc-400 transition-colors duration-200 hover:text-[#bfff00]"
                >
                  <span class="font-bold text-[#bfff00]/50 transition-colors duration-200 group-hover:text-[#bfff00]">
                    »
                  </span>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ─── Col 3: Contact Info ─── -->
      <div id="footer-contact">
        <h3
          class="relative mb-6 pb-3 text-xl font-bold tracking-wide text-white
                 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-12 after:bg-[#bfff00] after:content-['']"
          style="font-family:'Space Grotesk',sans-serif;"
        >
          Contact
        </h3>
        <ul class="space-y-4">
          <!-- Phone -->
          <li class="flex items-start gap-3">
            <div
              class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg border border-[#bfff00]/20 bg-[#bfff00]/10"
            >
              <svg
                class="h-3.5 w-3.5 text-[#bfff00]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M2.25 6.338c0-1.16.924-2.088 2.066-2.088h.853c.44 0 .832.285.966.706l1.046 3.3a1.013 1.013 0 01-.312 1.074l-1.145.938c-.12.098-.15.27-.065.394a12.067 12.067 0 005.658 5.658c.124.086.296.055.394-.065l.938-1.145a1.013 1.013 0 011.074-.312l3.3 1.046c.421.134.706.527.706.966v.854A2.077 2.077 0 0117.663 21.75C9.145 21.75 2.25 14.855 2.25 6.338z"
                ></path>
              </svg>
            </div>
            <div>
              <p
                class="text-[10px] font-semibold uppercase tracking-widest text-zinc-600"
              >
                Phone
              </p>
              <a
                href="tel:+628120000000"
                class="text-sm text-zinc-300 transition-colors duration-200 hover:text-[#bfff00]"
                >+62 812-XXXX-XXXX</a
              >
            </div>
          </li>
          <!-- Email -->
          <li class="flex items-start gap-3">
            <div
              class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg border border-[#bfff00]/20 bg-[#bfff00]/10"
            >
              <svg
                class="h-3.5 w-3.5 text-[#bfff00]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                ></path>
              </svg>
            </div>
            <div>
              <p
                class="text-[10px] font-semibold uppercase tracking-widest text-zinc-600"
              >
                Email
              </p>
              <a
                href="mailto:kontak@ahmadfaqih.dev"
                class="text-sm text-zinc-300 transition-colors duration-200 hover:text-[#bfff00]"
                >kontak@ahmadfaqih.dev</a
              >
            </div>
          </li>
          <!-- Location -->
          <li class="flex items-start gap-3">
            <div
              class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg border border-[#bfff00]/20 bg-[#bfff00]/10"
            >
              <svg
                class="h-3.5 w-3.5 text-[#bfff00]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p
                class="text-[10px] font-semibold uppercase tracking-widest text-zinc-600"
              >
                Location
              </p>
              <span class="text-sm text-zinc-300">Tegal - Jakarta</span>
            </div>
          </li>
          <!-- Website -->
          <li class="flex items-start gap-3">
            <div
              class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg border border-[#bfff00]/20 bg-[#bfff00]/10"
            >
              <svg
                class="h-3.5 w-3.5 text-[#bfff00]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253"
                ></path>
              </svg>
            </div>
            <div>
              <p
                class="text-[10px] font-semibold uppercase tracking-widest text-zinc-600"
              >
                Website
              </p>
              <a
                href="https://ngreksodigital.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-zinc-300 transition-colors duration-200 hover:text-[#bfff00]"
                >ngreksodigital.com</a
              >
            </div>
          </li>
        </ul>
      </div>

      <!-- ─── Col 4: Newsletter ─── -->
      <div id="footer-newsletter">
        <h3
          class="relative mb-6 pb-3 text-xl font-bold tracking-wide text-white
                 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-12 after:bg-[#bfff00] after:content-['']"
          style="font-family:'Space Grotesk',sans-serif;"
        >
          Newsletter
        </h3>
        <p class="mb-5 text-sm leading-relaxed text-zinc-400">
          Discover insights, actionable technical SEO tactics, and modern
          digital strategies that shape high-converting projects.
        </p>
        <form
          onsubmit="return false;"
          class="relative mt-4"
          id="footer-newsletter-form"
          aria-label="Newsletter subscription"
        >
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="Your email address..."
            autocomplete="email"
            class="w-full rounded-full border border-zinc-800 bg-transparent py-4 pl-6 pr-14 text-sm text-white
                   placeholder-zinc-500 transition-colors duration-200
                   focus:border-[#bfff00] focus:outline-none focus:shadow-[0_0_0_3px_rgba(191,255,0,0.08)]"
          />
          <button
            type="submit"
            aria-label="Subscribe to newsletter"
            class="absolute right-2 top-1/2 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full
                   bg-[#bfff00] text-black transition-all duration-300 hover:bg-[#d4ff33]
                   hover:shadow-[0_0_16px_rgba(191,255,0,0.5)] active:scale-95"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"
              ></path>
            </svg>
          </button>
        </form>
      </div>
    </div><!-- /4-col grid -->

    <!-- ── Bottom Bar ── -->
    <div class="border-t border-zinc-900 pt-8 text-center">
      <p class="text-sm text-zinc-500">
        Copyright &copy; 2026 Ahmad Faqih. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>
